<?xml version="1.0" encoding="utf-8"?>
<!-- Card de placeholder (skeleton) com a mesma silhueta do item_ticket_card. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.FieldService.Card.Static"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <View
            android:layout_width="64dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="180dp"
            android:layout_height="18dp"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="240dp"
            android:layout_height="14dp"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_skeleton_block" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <View
                android:layout_width="72dp"
                android:layout_height="24dp"
                android:layout_marginEnd="@dimen/space_xs"
                android:background="@drawable/bg_skeleton_block" />

            <View
                android:layout_width="88dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_skeleton_block" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
